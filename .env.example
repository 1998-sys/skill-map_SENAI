# Copie para .env.local e preencha. NUNCA comite .env.local (tem segredos).
# O Prisma também lê um .env com DATABASE_URL e DIRECT_URL (migrations).

# ─── Supabase → Project Settings → API ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço (Secret) — somente no servidor
SUPABASE_SERVICE_ROLE_KEY=

# ─── Supabase → botão "Connect" → ORMs (Prisma) ─────────────
# DATABASE_URL: Transaction pooler (porta 6543) + ?pgbouncer=true
DATABASE_URL=
# DIRECT_URL: conexão direta/sessão (porta 5432) — usada nas migrations
DIRECT_URL=

# ─── OpenAI (análise pedagógica com IA) ─────────────────────
OPENAI_API_KEY=
# Modelo (vazio = gpt-5-nano). Alternativas: gpt-5-mini, gpt-4.1-mini
OPENAI_MODEL=
